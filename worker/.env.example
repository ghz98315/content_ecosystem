# Supabase（worker 用 service_role key，绕过 RLS）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# 大模型（M1+ 才用，M0 可留空）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
THIRDPARTY_DOUYIN_KEY=

# 抖音 cookie 文件路径（默认 worker/cookies.txt）
# 用浏览器插件 "Get cookies.txt LOCALLY" 在 douyin.com 导出
DOUYIN_COOKIES=

# 轮询间隔（秒）
WORKER_POLL_INTERVAL=3
