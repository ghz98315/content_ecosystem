# Supabase（worker 用 service_role key，绕过 RLS）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# 大模型（清洗/改写/生图/书名反推）
OPENAI_API_KEY=your-key-here
# 第三方中转填此项，官方API留空即可（例：https://api.xcode.best/v1）
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT=110
DEEPSEEK_RETRIES=1
CLEAN_MODEL=deepseek-chat

# 生图后端：openai（默认）| doubao（豆包）
IMAGE_PROVIDER=openai

# gpt 生图（走中转，如 xcode.best 的生图套餐）
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=gpt-image-2

# doubao（豆包）生图 —— 后续补充 key 后填写
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_IMAGE_MODEL=doubao-seedream-3-0-t2i-250415
THIRDPARTY_DOUYIN_KEY=

# 抖音 cookie 文件路径（可选后备；默认自动生成匿名 cookie，无需手动导出）
# 仅当自动解析被风控失败时，才用浏览器插件 "Get cookies.txt LOCALLY" 导出 douyin.com 的 cookie
DOUYIN_COOKIES=

# 正式任务默认保持 edge；CosyVoice2 先通过 tts_compare.py 独立试听
TTS_PROVIDER=edge
# TTS 音色（edge-tts，可选值见 edge-tts --list-voices | grep zh-CN）
TTS_VOICE=zh-CN-XiaoxiaoNeural
# 长文案按约 26 秒拆段，最多同时合成 3 段
TTS_SEGMENT_CHARS=90
TTS_CONCURRENCY=3

# CosyVoice2（OpenAI-compatible /audio/speech 接口；独立试听阶段使用）
COSYVOICE2_BASE_URL=
# 若服务不是 /audio/speech，可直接填写完整地址并覆盖 BASE_URL
COSYVOICE2_ENDPOINT=
COSYVOICE2_API_KEY=
COSYVOICE2_MODEL=cosyvoice2
COSYVOICE2_VOICE=
COSYVOICE2_TIMEOUT=120
# 真实试听验收完成前必须保持 false
COSYVOICE2_PRODUCTION_ENABLED=false

# DashScope voice cloning (creation is explicit; target model must match synthesis model)
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_MODEL=cosyvoice-v3-flash
DASHSCOPE_VOICE=
DASHSCOPE_VOICE_PROFILE=
DASHSCOPE_VOICE_PROFILES_JSON={"system_default":{"model":"cosyvoice-v3-flash","voice":"longsanshu_v3"}}
DASHSCOPE_ENDPOINT=
DASHSCOPE_CUSTOMIZATION_ENDPOINT=
DASHSCOPE_CLONE_TARGET_MODEL=

# Whisper 逐字稿（本地 faster-whisper）
WHISPER_MODEL=small       # tiny/base/small/medium/large-v3，中文建议 small 或 medium
WHISPER_DEVICE=cpu        # cpu 或 cuda（有 N 卡填 cuda 更快）
WHISPER_COMPUTE=int8      # cpu 用 int8；cuda 用 float16
