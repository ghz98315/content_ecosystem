# Supabase（worker 用 service_role key，绕过 RLS）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Worker isolation and optional 恒源云 automation.
WORKER_POLL_INTERVAL=3
WORKER_HEARTBEAT_INTERVAL=20
WORKER_STALE_STAGE_SECONDS=300
GPUSHARE_STORAGE_STATE=
GPUSHARE_INSTANCE_URL=https://gpushare.com/instance
GPUSHARE_START_SELECTOR=text=开机
GPUSHARE_SSH_HOST=
GPUSHARE_SSH_PORT=22
GPUSHARE_SSH_USER=root
GPUSHARE_SSH_KEY=
# 可替代 SSH 参数，填本机安全脚本命令：GPUSHARE_SHUTDOWN_COMMAND=

# 大模型（清洗/改写/生图/书名反推）
OPENAI_API_KEY=
# 第三方中转填此项，官方API留空即可（例：https://api.xcode.best/v1）
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT=110
DEEPSEEK_RETRIES=1
CLEAN_MODEL=deepseek-chat
# 长文改写默认直连 DeepSeek，避免经过 OPENAI_BASE_URL 的第三方中转。
# 可选：deepseek | openai
REWRITE_PROVIDER=deepseek
REWRITE_MODEL=deepseek-chat
REWRITE_TIMEOUT=150
REWRITE_RETRIES=2
# 双人长文改写需保留完整逻辑，避免默认输出上限截断为摘要。
REWRITE_MAX_TOKENS=8192

# 生图后端：openai（默认）| doubao（豆包）
IMAGE_PROVIDER=apimart

# Task-level image channels. APIMart is the production default; xcode.best is
# selected explicitly on the task image stage when the primary is unavailable.
APIMART_IMAGE_API_KEY=
APIMART_IMAGE_BASE_URL=https://api.apimart.ai/v1
APIMART_IMAGE_MODEL=gpt-image-2
APIMART_IMAGE_RESOLUTION=1k
XCODE_IMAGE_API_KEY=
XCODE_IMAGE_BASE_URL=https://api.xcode.best/v1
XCODE_IMAGE_MODEL=gpt-image-2

# gpt 生图（走中转，如 xcode.best 的生图套餐）
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=gpt-image-2

# doubao（豆包）生图 —— 后续补充 key 后填写
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_IMAGE_MODEL=doubao-seedream-3-0-t2i-250415
THIRDPARTY_DOUYIN_KEY=

# 抖音 cookie 文件路径（可选后备；默认自动生成匿名 cookie，无需手动导出）
# 仅当自动解析被风控失败时，才用浏览器插件 "Get cookies.txt LOCALLY" 导出 douyin.com 的 cookie
DOUYIN_COOKIES=

# IndexTTS2.5 长文验收通过前保持 edge；通过后改为 indextts25
TTS_PROVIDER=edge
# TTS 音色（edge-tts，可选值见 edge-tts --list-voices | grep zh-CN）
TTS_VOICE=zh-CN-XiaoxiaoNeural
# 长文案按约 26 秒拆段，最多同时合成 3 段
TTS_SEGMENT_CHARS=90
TTS_CONCURRENCY=3
COSYVOICE_TTS_CONCURRENCY=1
COSYVOICE_TTS_REQUEST_GAP=1.2
# 仅当主 Provider 为 IndexTTS2.5 时生效；任何回退都会整篇重做，不混合音色
TTS_FALLBACK_PROVIDERS=cosyvoice2,edge
COSYVOICE2_FALLBACK_VOICE=
COSYVOICE2_FALLBACK_MODEL=
EDGE_TTS_FALLBACK_VOICE=zh-CN-XiaoxiaoNeural

# IndexTTS2.5（恒源云常驻 HTTP 服务）
INDEXTTS25_BASE_URL=
INDEXTTS25_ENDPOINT=
INDEXTTS25_HEALTH_ENDPOINT=
INDEXTTS25_API_TOKEN=
INDEXTTS25_MODEL=index-tts-2.5
INDEXTTS25_USE_BF16=false
# 必须与云端 INDEXTTS25_VOICE_PROFILES_JSON 中的 key 一致
INDEXTTS25_VOICE=narrator35
INDEXTTS25_TIMEOUT=300
INDEXTTS25_SEGMENT_CHARS=220
INDEXTTS25_MAX_SEGMENT_CHARS=280
INDEXTTS25_DURATION_FACTOR=1.00
INDEXTTS25_USE_QWEN_EMOTION=true
# Comma-separated profiles that must use plain IndexTTS inference. This is
# useful for cross-language reference clips; leave empty for normal profiles.
INDEXTTS25_PLAIN_VOICES=
INDEXTTS25_EMO_ALPHA=0.55
INDEXTTS25_EMOTION_TEXT=自然、有交流感地讲述，语气随语义起伏；重点自然加强，解释处放松，句末自然收束，不要播音腔。
# 2000 字真实长文验收通过前必须保持 false
INDEXTTS25_PRODUCTION_ENABLED=false

# 以下两项配置在恒源云服务进程环境中，不配置空闲关机时长则永不自动关机
INDEXTTS25_VOICE_PROFILES_JSON={"narrator35":"samples/narrator35.mp3","history_narrator":"samples/history_narrator.mp3"}
INDEXTTS25_IDLE_SHUTDOWN_SECONDS=0

# CosyVoice2（OpenAI-compatible /audio/speech 接口；独立试听阶段使用）
COSYVOICE2_BASE_URL=
# 若服务不是 /audio/speech，可直接填写完整地址并覆盖 BASE_URL
COSYVOICE2_ENDPOINT=
COSYVOICE2_API_KEY=
COSYVOICE2_MODEL=cosyvoice2
COSYVOICE2_VOICE=
COSYVOICE2_TIMEOUT=120
# 真实试听验收完成前必须保持 false
COSYVOICE2_PRODUCTION_ENABLED=false

# DashScope voice cloning (creation is explicit; target model must match synthesis model)
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_MODEL=cosyvoice-v3-flash
DASHSCOPE_VOICE=
DASHSCOPE_VOICE_PROFILE=
DASHSCOPE_VOICE_PROFILES_JSON={"system_default":{"model":"cosyvoice-v3-flash","voice":"longsanshu_v3"}}
DASHSCOPE_ENDPOINT=
DASHSCOPE_CUSTOMIZATION_ENDPOINT=
DASHSCOPE_CLONE_TARGET_MODEL=

# Whisper 逐字稿（本地 faster-whisper）
WHISPER_MODEL=small       # tiny/base/small/medium/large-v3，中文建议 small 或 medium
WHISPER_DEVICE=cpu        # cpu 或 cuda（有 N 卡填 cuda 更快）
WHISPER_COMPUTE=int8      # cpu 用 int8；cuda 用 float16

# 发布管理凭据（仅发布时使用，不是 Worker 业务必需项；请勿提交实际值）
# 数据库迁移：以下两项任选其一
# DATABASE_URL=
# SUPABASE_ACCESS_TOKEN=
# 前端发布（可替代 Vercel 管理页面登录）
# VERCEL_TOKEN=
